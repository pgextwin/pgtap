{
  "schemaVersion": 1,
  "distribution": "sql-only",
  "files": [
    {
      "source": "upstream",
      "path": "pgtap.control",
      "destination": "share/extension/pgtap.control",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "pgtap--{version}.sql",
      "destination": "share/extension/pgtap--{version}.sql",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "licenseDocument",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "packaging",
      "path": "README.md",
      "destination": "PGEXTWIN-README.md",
      "targets": [
        "zip"
      ]
    }
  ],
  "packageInfo": [
    "pgtap unofficial Windows x64 package",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref: {upstreamRef}",
    "Upstream commit: {upstreamCommit}",
    "Version: {version}",
    "PostgreSQL major: {pgMajor}",
    "PostgreSQL tested: {pgTested}",
    "Architecture: {architecture}"
  ],
  "packageInfoFinalNewline": false
}
